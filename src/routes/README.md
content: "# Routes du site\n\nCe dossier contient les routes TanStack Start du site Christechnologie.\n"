        </TabsContent>
        <TabsContent value="media"><MediaManager /></TabsContent>
        <TabsContent value="services">
          <CrudList table="services" fields={[{ k: "category", p: "Catégorie" }, { k: "title", p: "Titre" }, { k: "price", p: "Prix (optionnel)" }, { k: "description", p: "Description", long: true }, { k: "form_fields", p: "Questions", form: true }]} />
        </TabsContent>
        <TabsContent value="products">
          <CrudList table="products" fields={[{ k: "name", p: "Nom" }, { k: "price", p: "Prix" }, { k: "description", p: "Description", long: true }, { k: "image_url", p: "Image", image: true }, { k: "kind", p: "Type", choice: [{ v: "physique", l: "Physique" }, { v: "numerique", l: "Numérique" }] }]} />
        </TabsContent>
      </Tabs>
    </main>
  );
}

function ShipmentsManager() {
  const { data = [] } = useTable<Item>("shipments");
  const refresh = useRefresh();
  const [draft, setDraft] = useState({
    tracking_number: "",
    client_name: "",
    client_email: "",
    client_phone: "",
    destination: "",
    status: "en_attente",
    status_notes: "",
  });

  const save = async () => {
    const payload = { ...draft, tracking_number: draft.tracking_number || `CHRIS-${Date.now().toString().slice(-5)}` };
    const { error } = await db.from("shipments").insert(payload);
    if (error) {
      toast.error(error.message);
      return;
    }
    toast.success("Expédition ajoutée");
    setDraft({ tracking_number: "", client_name: "", client_email: "", client_phone: "", destination: "", status: "en_attente", status_notes: "" });
    refresh("shipments");
  };

  return (
    <div className="space-y-4">
      <div className="rounded-2xl border bg-card p-4 space-y-3">
        <Input placeholder="Numéro de suivi" value={draft.tracking_number} onChange={(e) => setDraft({ ...draft, tracking_number: e.target.value })} />
        <Input placeholder="Nom du client" value={draft.client_name} onChange={(e) => setDraft({ ...draft, client_name: e.target.value })} />
        <Input placeholder="Email du client" value={draft.client_email} onChange={(e) => setDraft({ ...draft, client_email: e.target.value })} />
        <Input placeholder="Téléphone" value={draft.client_phone} onChange={(e) => setDraft({ ...draft, client_phone: e.target.value })} />
        <Input placeholder="Destination" value={draft.destination} onChange={(e) => setDraft({ ...draft, destination: e.target.value })} />
        <select value={draft.status} onChange={(e) => setDraft({ ...draft, status: e.target.value })} className="h-10 w-full rounded-md border bg-background px-3 text-sm">
          <option value="en_attente">En attente</option>
          <option value="en_transit">En transit</option>
          <option value="arrive_point_relais">Arrivé au point relais</option>
          <option value="livre">Livré</option>
        </select>
        <Textarea rows={3} placeholder="Notes du statut" value={draft.status_notes} onChange={(e) => setDraft({ ...draft, status_notes: e.target.value })} />
        <Button onClick={save}>Créer l’expédition</Button>
      </div>

      <div className="space-y-3">
        {data.map((row: any) => (
          <div key={row.id} className="rounded-xl border bg-card p-4">
            <div className="flex justify-between gap-3">
              <strong>{row.tracking_number}</strong>
              <span className="text-sm text-accent">{row.status}</span>
            </div>
            <p className="mt-2 text-sm text-muted-foreground">{row.client_name} · {row.client_email}</p>
            <p className="mt-1 text-sm text-muted-foreground">{row.destination}</p>
          </div>
        ))}
      </div>
    </div>
  );
}

function CustomPagesManager() {
  const { data = [] } = useTable<Item>("custom_pages");
  const refresh = useRefresh();
  const [draft, setDraft] = useState({
    slug: "",
    title: "",
    content_type: "html",
    content_data: "{\"text\": \"\"}",
    show_in_menu: true,
    published: true,
  });

  const save = async () => {
    const { error } = await db.from("custom_pages").insert({
      ...draft,
      content_data: typeof draft.content_data === "string" ? draft.content_data : JSON.stringify(draft.content_data),
    });
    if (error) {
      toast.error(error.message);
      return;
    }
    toast.success("Page CMS enregistrée");
    setDraft({ slug: "", title: "", content_type: "html", content_data: "{\"text\": \"\"}", show_in_menu: true, published: true });
    refresh("custom_pages");
  };

  return (
    <div className="space-y-4">
      <div className="rounded-2xl border bg-card p-4 space-y-3">
        <Input placeholder="Slug (ex: motivation)" value={draft.slug} onChange={(e) => setDraft({ ...draft, slug: e.target.value })} />
        <Input placeholder="Titre" value={draft.title} onChange={(e) => setDraft({ ...draft, title: e.target.value })} />
        <select value={draft.content_type} onChange={(e) => setDraft({ ...draft, content_type: e.target.value })} className="h-10 w-full rounded-md border bg-background px-3 text-sm">
          <option value="iframe">iframe</option>
          <option value="youtube">youtube</option>
          <option value="whatsapp_bot">whatsapp_bot</option>
          <option value="html">html</option>
          <option value="form">form</option>
        </select>
        <Textarea rows={3} placeholder="Données JSON / texte" value={draft.content_data} onChange={(e) => setDraft({ ...draft, content_data: e.target.value })} />
        <label className="flex items-center gap-2 text-sm">
          <input type="checkbox" checked={draft.show_in_menu} onChange={(e) => setDraft({ ...draft, show_in_menu: e.target.checked })} />
          Afficher dans le menu
        </label>
        <label className="flex items-center gap-2 text-sm">
          <input type="checkbox" checked={draft.published} onChange={(e) => setDraft({ ...draft, published: e.target.checked })} />
          Publié
        </label>
        <Button onClick={save}>Créer la page</Button>
      </div>

      <div className="space-y-3">
        {data.map((page: any) => (
          <div key={page.id} className="rounded-xl border bg-card p-4">
            <div className="flex justify-between gap-3">
              <strong>{page.title}</strong>
              <span className="text-sm text-accent">{page.published ? "Publiée" : "Brouillon"}</span>
            </div>
            <p className="mt-2 text-sm text-muted-foreground">/{page.slug}</p>
          </div>
        ))}
      </div>
    </div>
  );
}

function Inbox({ table }: { table: string }) {
  const { data = [] } = useTable<Item>(table, "created_at");
  const refresh = useRefresh();
  const remove = async (id: string) => { await db.from(table).delete().eq("id", id); refresh(table); };
  const setStatus = async (id: string, status: string) => { await db.from(table).update({ status }).eq("id", id); refresh(table); };
  if (!data.length) return <p className="py-8 text-muted-foreground">Rien pour l'instant.</p>;
  return (
    <div className="space-y-3">
      {data.map((r) => (
        <div key={r.id} className="rounded-xl border bg-card p-4">
          <div className="flex justify-between gap-2 text-sm">
            <span className="font-bold">{r.name || r.client_name || r.title || "—"} · <span className="text-accent">{r.contact || r.client_email || r.client_phone || "—"}</span></span>
            <span className="text-muted-foreground">{new Date(r.created_at).toLocaleString("fr")}</span>
          </div>
          {r.item && <p className="mt-1 text-primary">{r.item}{r.quantity > 1 && ` × ${r.quantity}`}</p>}
          {r.answers?.length > 0 && (
            <dl className="mt-2 space-y-1 rounded-lg bg-secondary p-2 text-sm">
              {r.answers.map((a: any, i: number) => (<div key={i}><dt className="inline font-medium">{a.label} : </dt><dd className="inline text-muted-foreground">{a.value || "—"}</dd></div>))}
            </dl>
          )}
          {r.payment_ref && <p className="mt-2 text-sm">Réf. paiement : <span className="text-accent">{r.payment_ref}</span></p>}
          <p className="mt-2 whitespace-pre-wrap text-sm text-muted-foreground">{r.message || r.status_notes}</p>
          <div className="mt-3 flex gap-2">
            {table === "orders" && (
              <select value={r.status} onChange={(e) => setStatus(r.id, e.target.value)} className="rounded-md border bg-secondary px-2 text-sm">
                <option value="nouveau">Nouveau</option><option value="en cours">En cours</option><option value="terminé">Terminé</option>
              </select>
            )}
            <Button size="sm" variant="ghost" onClick={() => remove(r.id)}><Trash2 className="h-4 w-4" /></Button>
          </div>
        </div>
      ))}
    </div>
  );
}

const CONTENT_KEYS = [
  { k: "name", l: "Nom" }, { k: "tagline", l: "Slogan" }, { k: "bio", l: "Bio", long: true },
  { k: "payment_info", l: "Instructions de paiement manuel (par défaut)", long: true },
